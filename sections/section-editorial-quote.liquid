{{ 'section-editorial-common.css' | asset_url | stylesheet_tag }}
{{ 'section-editorial-quote.css' | asset_url | stylesheet_tag }}

<div class="editorial-quote editorial-section background-{{ section.settings.background_color }}
            {% if section.settings.add_top_padding %}padding-top-6{% endif %}
            {% if section.settings.add_bottom_padding %}padding-bottom-6{% endif %}">
  <div class="content-wrapper">
    <div class="quote-container">
      <h2 class="quote {{ section.settings.heading_size }}">{{ section.settings.quote }}</h2>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial Quote",
  "settings": [
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "T2"
        },
        {
          "value": "h1",
          "label": "T1"
        },
        {
          "value": "h0",
          "label": "T0"
        }
      ],
      "default": "h1",
      "label": "Quote size"
    },
    {
      "type": "select",
      "id": "background_color",
      "options": [
        { "value": "none", "label": "No background" },
        { "value": "charcoal", "label": "Charcoal (#2C2F38)" },
        { "value": "slate-blue", "label": "Slate Blue (#38496F)" },
        { "value": "cool-grey", "label": "Cool Grey (#7D868D)" },
        { "value": "warm-beige", "label": "Warm Beige (#EBE2D9)" },
        { "value": "olive-brown", "label": "Olive Brown (#4A463D)" },
        { "value": "moss", "label": "Moss (#57564B)" },
        { "value": "mustard-brown", "label": "Mustard Brown (#95794A)" },
        { "value": "sand", "label": "Sand (#CFA55D)" },
        { "value": "deep-brown", "label": "Deep Brown (#2A1B12)" },
        { "value": "burgundy", "label": "Burgundy (#5E1B1C)" },
        { "value": "taupe", "label": "Taupe (#B0977B)" },
        { "value": "clay", "label": "Clay (#95634B)" },
        { "value": "stone-grey", "label": "Stone Grey (#8E9492)" }
      ],
      "default": "none",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "checkbox",
      "id": "add_top_padding",
      "label": "Add top padding",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "add_bottom_padding",
      "label": "Add bottom padding",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Editorial Quote",
      "category": "Editorial"
    }
  ]
}
{% endschema %}
