{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'section-home-split.css' | asset_url | stylesheet_tag }}
{{ 'section-editorial-common.css' | asset_url | stylesheet_tag }}

<div class="home-section-image background-{{ section.settings.background_color }}
{% if section.settings.padding_top_enabled %}home-section-image--padding-top{% endif %}
{% if section.settings.padding_bottom_enabled %}home-section-image--padding-bottom{% endif %}
{% if section.settings.padding_horizontal_enabled %}home-section-image--padding-horizontal{% endif %}">
<div class="home-section-image__container">
<div class="home-section-image__media">
{%- if section.settings.video_url != blank -%}
<div class="custom-vimeo-player" id="custom-vimeo-{{ section.id }}">
  <div class="custom-vimeo-player__frame-wrap">
    <iframe
      id="vimeo-iframe-{{ section.id }}"
      src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?title=0&byline=0&portrait=0&controls=0"
      class="home-section-image__media-video"
      style="width: 100%; aspect-ratio: 16 / 9; display: block; border: 0;"
      frameborder="0"
      allow="autoplay; fullscreen; picture-in-picture"
      loading="lazy"
      title="{{ section.settings.caption | strip_html | escape }}"
    ></iframe>
  </div>
  <div class="custom-vimeo-player__controls">
    <button type="button" class="custom-vimeo-player__play" aria-label="Play">
      <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" style="display:none;"><path fill="currentColor" d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
    <span class="custom-vimeo-player__time custom-vimeo-player__time--current">0:00</span>
    <input type="range" class="custom-vimeo-player__scrubber" min="0" max="100" value="0" step="0.1" aria-label="Seek">
    <span class="custom-vimeo-player__time custom-vimeo-player__time--duration">0:00</span>
    <button type="button" class="custom-vimeo-player__mute" aria-label="Mute">
      <svg class="icon-vol-on" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3zm13.5 2a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 16.5 12z"/></svg>
      <svg class="icon-vol-off" viewBox="0 0 24 24" width="18" height="18" style="display:none;"><path fill="currentColor" d="M3 10v4h4l5 5V5L7 10H3zm14.59-1.41L16 10.17l-1.59-1.58L13 10l1.58 1.59L13 13.17l1.41 1.42L16 13l1.59 1.59L19 13.17l-1.58-1.58L19 10z"/></svg>
    </button>
    <input type="range" class="custom-vimeo-player__volume" min="0" max="100" value="100" step="1" aria-label="Volume">
  </div>
</div>
<script src="https://player.vimeo.com/api/player.js"></script>
<script>
(function() {
  var iframe = document.getElementById('vimeo-iframe-{{ section.id }}');
  var wrap = document.getElementById('custom-vimeo-{{ section.id }}');
  if (!iframe || !wrap || typeof Vimeo === 'undefined') return;

  var player = new Vimeo.Player(iframe);
  var playBtn = wrap.querySelector('.custom-vimeo-player__play');
  var iconPlay = wrap.querySelector('.icon-play');
  var iconPause = wrap.querySelector('.icon-pause');
  var muteBtn = wrap.querySelector('.custom-vimeo-player__mute');
  var iconVolOn = wrap.querySelector('.icon-vol-on');
  var iconVolOff = wrap.querySelector('.icon-vol-off');
  var scrubber = wrap.querySelector('.custom-vimeo-player__scrubber');
  var volumeSlider = wrap.querySelector('.custom-vimeo-player__volume');
  var currentTimeEl = wrap.querySelector('.custom-vimeo-player__time--current');
  var durationEl = wrap.querySelector('.custom-vimeo-player__time--duration');
  var isSeeking = false;

  function formatTime(sec) {
    sec = Math.floor(sec || 0);
    var m = Math.floor(sec / 60);
    var s = sec % 60;
    return m + ':' + (s < 10 ? '0' : '') + s;
  }

  player.getDuration().then(function(duration) {
    durationEl.textContent = formatTime(duration);
  });

  playBtn.addEventListener('click', function() {
    player.getPaused().then(function(paused) {
      if (paused) {
        player.play();
      } else {
        player.pause();
      }
    });
  });

  player.on('play', function() {
    iconPlay.style.display = 'none';
    iconPause.style.display = '';
    playBtn.setAttribute('aria-label', 'Pause');
  });

  player.on('pause', function() {
    iconPlay.style.display = '';
    iconPause.style.display = 'none';
    playBtn.setAttribute('aria-label', 'Play');
  });

  player.on('timeupdate', function(data) {
    if (isSeeking) return;
    currentTimeEl.textContent = formatTime(data.seconds);
    scrubber.value = data.percent * 100;
  });

  scrubber.addEventListener('input', function() {
    isSeeking = true;
    player.getDuration().then(function(duration) {
      var seekTo = (scrubber.value / 100) * duration;
      currentTimeEl.textContent = formatTime(seekTo);
    });
  });

  scrubber.addEventListener('change', function() {
    player.getDuration().then(function(duration) {
      var seekTo = (scrubber.value / 100) * duration;
      player.setCurrentTime(seekTo).then(function() {
        isSeeking = false;
      });
    });
  });

  muteBtn.addEventListener('click', function() {
    player.getVolume().then(function(vol) {
      if (vol > 0) {
        muteBtn.dataset.prevVolume = vol;
        player.setVolume(0);
      } else {
        var restore = parseFloat(muteBtn.dataset.prevVolume) || 1;
        player.setVolume(restore);
      }
    });
  });

  volumeSlider.addEventListener('input', function() {
    var vol = volumeSlider.value / 100;
    player.setVolume(vol);
  });

  player.on('volumechange', function(data) {
    if (data.volume > 0) {
      iconVolOn.style.display = '';
      iconVolOff.style.display = 'none';
      volumeSlider.value = data.volume * 100;
    } else {
      iconVolOn.style.display = 'none';
      iconVolOff.style.display = '';
    }
  });
})();
</script>
<style>
.custom-vimeo-player {
  position: relative;
  width: 100%;
}
.custom-vimeo-player__frame-wrap {
  position: relative;
  width: 100%;
}
.custom-vimeo-player__controls {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: #111;
}
.custom-vimeo-player__play,
.custom-vimeo-player__mute {
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  flex-shrink: 0;
}
.custom-vimeo-player__time {
  color: #fff;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  min-width: 34px;
}
.custom-vimeo-player__scrubber {
  flex: 1;
  height: 3px;
  cursor: pointer;
}
.custom-vimeo-player__volume {
  width: 70px;
  height: 3px;
  cursor: pointer;
}
</style>
{%- elsif section.settings.image != blank -%}
{{ section.settings.image | image_url: width: 1500 | image_tag:
loading: 'lazy',
width: "100%",
height: "auto",
sizes: "100vw",
widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
class: "home-section-image__media-image"
}}
{%- else -%}
{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
</div>
{%- if section.settings.caption != blank -%}
<div class="caption home-section-image__caption">{{ section.settings.caption }}</div>
{%- endif -%}
</div>
</div>

{% schema %}
{
"name": "Home Image Section",
"class": "section",
"settings": [
    {
"type": "video_url",
"id": "video_url",
"accept": ["vimeo"],
"label": "Video (Vimeo URL)",
"info": "If set, this plays instead of the image below."
    },
    {
"type": "image_picker",
"id": "image",
"label": "Image",
"info": "Used as a fallback if no video is set, and as the poster/cover image for the video."
    },
    {
"type": "richtext",
"id": "caption",
"label": "Caption"
    },
    {
"type": "select",
"id": "background_color",
"options": [
        {
"value": "none",
"label": "No background"
        },
        {
"value": "color-1",
"label": "Color 1"
        },
        {
"value": "color-2",
"label": "Color 2"
        },
        {
"value": "color-3",
"label": "Color 3"
        }
      ],
"default": "none",
"label": "Background color"
    },
    {
"type": "header",
"content": "Section padding"
    },
    {
"type": "checkbox",
"id": "padding_top_enabled",
"label": "Enable top padding",
"default": false
    },
    {
"type": "checkbox",
"id": "padding_bottom_enabled",
"label": "Enable bottom padding",
"default": false
    },
    {
"type": "checkbox",
"id": "padding_horizontal_enabled",
"label": "Enable horizontal padding",
"default": false
    }
  ],
"presets": [
    {
"name": "Home Image Section",
"category": "Image"
    }
  ]
}
{% endschema %}