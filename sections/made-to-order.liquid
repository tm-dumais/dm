{% comment %}
  Made to Order section: Uses a smart collection handle from a page metafield (custom.made_to_order_collection).
  Displays all products from that collection, grouped by their other collections (e.g., 'Collection 25.01').
  Matches the collection page layout. Debug output included.
{% endcomment %}

{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% assign collection_handle = page.metafields.custom.made_to_order_collection %}
<!-- DEBUG: Collection handle: '{{ collection_handle }}' -->

{% assign made_to_order_collection = collections[collection_handle] %}

<div style="background: #ffeeba; color: #222; padding: 2rem; font-size: 1.4rem; border: 2px solid #e0a800; margin-bottom: 2rem;">
  <b>DEBUG:</b><br>
  Collection handle: '{{ collection_handle }}'<br>
  Collection exists: {% if made_to_order_collection %}Yes{% else %}No{% endif %}<br>
  Products in collection: {% if made_to_order_collection %}{{ made_to_order_collection.products_count }}{% else %}0{% endif %}<br>
  <ul>
    {% if made_to_order_collection %}
      {% for product in made_to_order_collection.products %}
        <li>{{ product.title }}</li>
      {% endfor %}
    {% endif %}
  </ul>
</div>

{% if made_to_order_collection == nil or made_to_order_collection.products_count == 0 %}
  <div class="collection-hero">
    <div class="collection-hero__inner page-width">
      <h3 class="collection-hero__title">No collection found</h3>
      <div class="collection-hero__description rte">Please set the 'Made to Order Collection' metafield for this page to a valid collection handle.</div>
    </div>
  </div>
{% else %}
  <div class="collection section-pseudo">
    <div class="collection-hero">
      <div class="collection-hero__inner page-width">
        <h3 class="collection-hero__title">{{ made_to_order_collection.title }}</h3>
        {% if made_to_order_collection.description != blank %}
          <div class="collection-hero__description rte">{{ made_to_order_collection.description }}</div>
        {% endif %}
      </div>
    </div>
    <div class="collection__products page-width">
      <ul class="grid product-grid contains-card contains-card--product">
        {% for product in made_to_order_collection.products %}
          <li class="grid__item">
            {% render 'card-product', card_product: product, section_id: 'made-to-order' %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endif %} 