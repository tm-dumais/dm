{% comment %}
  Dynamic Made to Order section: Displays all products with the tag specified in the page metafield,
  grouped by their collection. Matches the visual style of collection pages.
  Metafield: custom.made_to_order_tag
{% endcomment %}

{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% assign tag = page.metafields.custom.made_to_order_tag %}

<!-- DEBUG: Tag value: '{{ tag }}' -->

{% if tag == blank %}
  <div class="collection-hero">
    <div class="collection-hero__inner page-width">
      <h3 class="collection-hero__title">No tag specified</h3>
      <div class="collection-hero__description rte">Please set the 'Made to Order Tag' metafield for this page.</div>
    </div>
  </div>
{% else %}
  {% assign all_products = collections['all'].products | where: "tags", tag %}
  <!-- DEBUG: Found {{ all_products.size }} products with tag '{{ tag }}' -->
  <ul style="background: #fffbe6; color: #222; padding: 1rem; font-size: 1.2rem;">
    <li><b>DEBUG:</b> Tag: '{{ tag }}'</li>
    <li>Products found: {{ all_products.size }}</li>
    {% for product in all_products %}
      <li>Product: {{ product.title }} (handle: {{ product.handle }})</li>
    {% endfor %}
  </ul>
  {% assign collections_with_tagged_products = '' %}
  {% for product in all_products %}
    {% for c in product.collections %}
      {% unless collections_with_tagged_products contains c.handle %}
        {% assign collections_with_tagged_products = collections_with_tagged_products | append: c.handle | append: ',' %}
      {% endunless %}
    {% endfor %}
  {% endfor %}
  {% assign collections_with_tagged_products = collections_with_tagged_products | split: ',' | uniq %}

  {% assign found_any = false %}
  {% for collection_handle in collections_with_tagged_products %}
    {% assign collection = collections[collection_handle] %}
    {% assign products_in_collection = collection.products | where: "tags", tag %}
    {% if products_in_collection.size > 0 %}
      {% assign found_any = true %}
      <div class="collection section-pseudo">
        <div class="collection-hero">
          <div class="collection-hero__inner page-width">
            <h3 class="collection-hero__title">{{ collection.title }}</h3>
            {% if collection.description != blank %}
              <div class="collection-hero__description rte">{{ collection.description }}</div>
            {% endif %}
          </div>
        </div>
        <div class="collection__products page-width">
          <ul class="grid product-grid contains-card contains-card--product">
            {% for product in products_in_collection %}
              <li class="grid__item">
                {% render 'card-product', card_product: product, section_id: 'made-to-order' %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% endfor %}
  {% unless found_any %}
    <div class="collection-hero">
      <div class="collection-hero__inner page-width">
        <h3 class="collection-hero__title">No products found</h3>
        <div class="collection-hero__description rte">No products found with tag '{{ tag }}'.</div>
      </div>
    </div>
  {% endunless %}
{% endif %} 